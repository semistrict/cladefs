load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

package(default_visibility = ["//visibility:public"])

go_proto_library(
    name = "mount_go_proto",
    compilers = [
        "@rules_go//proto:go_proto",
        "@rules_go//proto:go_grpc_v2",
    ],
    importpath = "github.com/semistrict/cladefs/go/mount/v1",
    proto = "//crates/cladefs/proto/cladefs/mount/v1:mount_proto",
)

go_library(
    name = "mountv1",
    embed = [":mount_go_proto"],
    importpath = "github.com/semistrict/cladefs/go/mount/v1",
)

target
__pycache__/
guide/node_modules/
guide/dist/
guide/dist-single/
guide/src/generated/
.agent-role
.agent-name
# What a mutant runner stopped by SIGKILL left in the tree (scripts/lib/patches.sh).
.mutant-in
# libmachine's Python bindings: uv's environment and the extension maturin builds into the package.
crates/libmachine-py/.venv/
crates/libmachine-py/python/libmachine/*.so
.pytest_cache/
# Bazel convenience symlinks and optional local overrides.
/bazel-*
.bazelrc.local
# Raw run output stays on the host that made it: of a run's results only the .md summaries are
# tracked, and the nightly's record of each night (scripts/nightly.py).
/docs/measurements/**
!/docs/measurements/**/
!/docs/measurements/**/*.md
!/docs/measurements/**/night.json

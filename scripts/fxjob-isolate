#!/usr/bin/env bash
# Copyright 2026 The cladefs Authors. All rights reserved.
# Use of this source code is governed by a BSD-style license that can be
# found in the LICENSE file.

# fxjob-isolate on|off|status: gives fxdax-bench.slice (of the user who runs this with sudo) the
# host's measurement CPUs to itself, and, where the host has them, most of its L3 and memory
# bandwidth, and the power budget the other cores leave it; `off` gives them back. fxjob --bench
# runs it around a measurement. `on` either isolates or fails: a measurement doesn't run
# unisolated.
#
# What it gives is the host's, /etc/fxjob.conf's (read here, as root, from that path alone):
#
#   BENCH_CPUS=4-7,12-15   the measurement's CPUs: a cpuset partition of their own, out of every
#                          other cgroup's CPUs; unbound workqueues and movable IRQs go to the rest
#   BENCH_L3=fff0          its L3 ways, a capacity bitmask (resctrl, Intel CAT or AMD L3 CAT),
#   WORK_L3=000f           everything else's; each in every L3 domain
#   WORK_MB=40             everything else's memory bandwidth (resctrl MBA, in the host's units:
#                          AMD's 1/8 GB/s), the measurement keeping what the host had
#   BENCH_CAP_CLOCKS=1     the other CPUs capped at their nominal clock (ACPI CPPC), leaving the
#                          package's power budget for the measurement's to boost with
#
# Each but BENCH_CPUS only where the conf sets it: ubu1 (AMD, 16 CPUs) sets them all; asahimbp
# (Apple Silicon) has no resctrl, and its CPUs share a clock with their cluster, cpu0 the
# measurement's (a cap on it would cap the measurement, which `on` refuses).
#
# Installed as /usr/local/libexec/fxjob-isolate, with fxjob, by the host's setup (ubu1's
# ~/docs/system-setup.d/146-fxdax_cgroups.sh, asahimbp's ~/setup/scripts/81-fxjob.sh), which
# gives the reasons for each part.
set -euo pipefail

conf=/etc/fxjob.conf
uid=${SUDO_UID:?"run with sudo"}
cg=/sys/fs/cgroup
user=user.slice/user-$uid.slice/user@$uid.service
chain=(user.slice "user.slice/user-$uid.slice" "$user" "$user/fxdax.slice"
  "$user/fxdax.slice/fxdax-bench.slice")
bench=$cg/${chain[-1]}
resctrl=/sys/fs/resctrl
state=/run/fxjob-isolate # what `on` changed, as it was: `off` restores it

bench_cpus='' bench_l3='' work_l3='' work_mb='' cap_clocks=0
if [[ -r $conf ]]; then
  while read -r line; do
    read -ra words <<< "${line%%#*}"
    for word in "${words[@]}"; do
      case $word in
        BENCH_CPUS=*) bench_cpus=${word#*=} ;;
        BENCH_L3=*) bench_l3=${word#*=} ;;
        WORK_L3=*) work_l3=${word#*=} ;;
        WORK_MB=*) work_mb=${word#*=} ;;
        BENCH_CAP_CLOCKS=*) cap_clocks=${word#*=} ;;
      esac
    done
  done < "$conf"
fi

# cpus_of LIST: each CPU of a cpulist (such as 0-3,8), a line each; fails for anything else.
cpus_of() {
  local part
  [[ $1 =~ ^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$ ]] || return 1
  for part in ${1//,/ }; do
    if [[ $part == *-* ]]; then seq "${part%-*}" "${part#*-}"; else echo "$part"; fi
  done
}
# list_of: the CPUs on standard input, a line each, as a cpulist.
list_of() { sort -n | paste -sd ,; }
# mask_of: the CPUs on standard input as a hex mask, in 32-bit words, most significant first,
# comma-separated, as the kernel's cpumask files take it.
mask_of() {
  local cpu words=() i out=''
  while read -r cpu; do
    i=$((cpu / 32))
    words[i]=$(( ${words[i]:-0} | 1 << (cpu % 32) ))
  done
  for (( i = ${#words[@]} - 1; i >= 0; i-- )); do
    out+=$(printf '%08x' "${words[i]:-0}")
    (( i == 0 )) || out+=,
  done
  echo "$out"
}
# schemata RESOURCE VALUE: RESOURCE's schemata line with VALUE in each of its domains, as the
# host's root group lists them.
schemata() {
  sed -n "s/^ *$1://p" $resctrl/schemata | tr ';' '\n' |
    awk -F= -v v="$2" -v r="$1" '{ d = d (d ? ";" : "") $1 "=" v } END { print r ":" d }'
}

online=$(cpus_of "$(< /sys/devices/system/cpu/online)")
bench_list=$(cpus_of "$bench_cpus" | list_of) ||
  { echo "fxjob-isolate: $conf's BENCH_CPUS is no cpulist: '$bench_cpus'" >&2; exit 1; }
# work: the other CPUs, every online one the measurement's partition leaves.
work_list=$(comm -23 <(sort <<< "$online") <(cpus_of "$bench_list" | sort) | list_of)
[[ -n $bench_list && -n $work_list ]] ||
  { echo "fxjob-isolate: BENCH_CPUS ($bench_cpus) leaves no CPU for the rest" >&2; exit 1; }
resctrl_used=0
if [[ -n $bench_l3 || -n $work_l3 || -n $work_mb ]]; then resctrl_used=1; fi

on() {
  [[ -d $bench ]] || { echo "fxjob-isolate: no $bench: the user's manager has no fxdax-bench.slice" >&2; exit 1; }
  local cpu
  if [[ $cap_clocks == 1 ]]; then
    # A clock shared with a measurement's CPU (a cluster's, on Apple Silicon) is not the others'
    # to cap.
    for cpu in $(cpus_of "$work_list"); do
      if comm -12 <(tr ' ' '\n' < "/sys/devices/system/cpu/cpu$cpu/cpufreq/related_cpus" | grep . | sort) \
        <(cpus_of "$bench_list" | sort) | grep -q .; then
        echo "fxjob-isolate: cpu$cpu shares its clock with BENCH_CPUS ($bench_list): BENCH_CAP_CLOCKS would cap the measurement" >&2
        exit 1
      fi
    done
  fi
  if (( resctrl_used )); then mountpoint -q $resctrl || mount -t resctrl resctrl $resctrl; fi
  # Saved once: after a job that died before its `off`, what is set is ours, not the host's.
  if [[ ! -d $state ]]; then
    mkdir -p "$state/irq" "$state/freq"
    cat /sys/devices/virtual/workqueue/cpumask > "$state/workqueue"
    cat /proc/irq/default_smp_affinity > "$state/default_smp_affinity"
    local irq
    for irq in /proc/irq/[0-9]*; do
      cat "$irq/smp_affinity_list" > "$state/irq/${irq##*/}"
    done
    if [[ $cap_clocks == 1 ]]; then
      for cpu in $(cpus_of "$work_list"); do
        cat "/sys/devices/system/cpu/cpu$cpu/cpufreq/scaling_max_freq" > "$state/freq/$cpu"
      done
    fi
    if (( resctrl_used )); then sed -n 's/^ *\(L3\|MB\):/\1:/p' $resctrl/schemata > "$state/schemata"; fi
  fi

  # CPUs: a partition root of its own, handed its CPUs down through every ancestor's exclusive
  # set (a remote partition): the kernel takes them out of every other cgroup's CPUs.
  local c
  for c in "${chain[@]}"; do echo "$bench_list" > "$cg/$c/cpuset.cpus.exclusive"; done
  echo "$bench_list" > "$bench/cpuset.cpus"
  echo root > "$bench/cpuset.cpus.partition"
  local partition effective
  partition=$(cat "$bench/cpuset.cpus.partition")
  effective=$(cpus_of "$(cat "$bench/cpuset.cpus.effective")" | list_of)
  if [[ $partition != root || $effective != "$bench_list" ]]; then
    echo "fxjob-isolate: fxdax-bench.slice is not a partition of $bench_list: $partition, $effective" >&2
    off
    exit 1
  fi

  # What runs outside any cgroup's cpuset: unbound workqueues and movable IRQs. Managed IRQs (a
  # device's per-CPU queues) can't be moved, and serve only what their CPU submits; nor can an
  # interrupt controller's that has no affinity (Apple's AIC).
  local work_mask
  work_mask=$(cpus_of "$work_list" | mask_of)
  echo "$work_mask" > /sys/devices/virtual/workqueue/cpumask
  echo "$work_mask" > /proc/irq/default_smp_affinity
  local irq
  for irq in /proc/irq/[0-9]*; do
    echo "$work_list" > "$irq/smp_affinity_list" 2> /dev/null || true
  done

  # Clocks: the other cores at their nominal frequency.
  if [[ $cap_clocks == 1 ]]; then
    local nominal
    for cpu in $(cpus_of "$work_list"); do
      nominal=$(cat "/sys/devices/system/cpu/cpu$cpu/acpi_cppc/nominal_freq")
      echo $((nominal * 1000)) > "/sys/devices/system/cpu/cpu$cpu/cpufreq/scaling_max_freq"
    done
  fi

  # Cache and memory bandwidth, by CPU: a task of the default group takes the class of the CPU
  # it runs on, so the partition's CPUs give whatever runs on them the measurement's class, which
  # keeps the host's memory bandwidth as it was.
  if (( resctrl_used )); then
    mkdir -p $resctrl/fxdax-bench
    echo "$bench_list" > $resctrl/fxdax-bench/cpus_list
    if [[ -n $bench_l3 ]]; then schemata L3 "$bench_l3" > $resctrl/fxdax-bench/schemata; fi
    if [[ -n $work_mb ]]; then sed -n '/^ *MB:/p' "$state/schemata" > $resctrl/fxdax-bench/schemata; fi
    if [[ -n $work_l3 ]]; then schemata L3 "$work_l3" > $resctrl/schemata; fi
    if [[ -n $work_mb ]]; then schemata MB "$work_mb" > $resctrl/schemata; fi
  fi
}

off() {
  local c i
  if [[ -d $bench ]]; then
    echo member > "$bench/cpuset.cpus.partition"
    echo > "$bench/cpuset.cpus"
  fi
  for ((i = ${#chain[@]} - 1; i >= 0; i--)); do
    c=$cg/${chain[i]}
    if [[ -d $c ]]; then echo > "$c/cpuset.cpus.exclusive"; fi
  done
  if [[ -d $resctrl/fxdax-bench ]]; then rmdir $resctrl/fxdax-bench; fi
  if [[ -d $state ]]; then
    local saved line
    if [[ -f $state/schemata ]]; then
      while read -r line; do echo "$line" > $resctrl/schemata; done < "$state/schemata"
    fi
    cat "$state/workqueue" > /sys/devices/virtual/workqueue/cpumask
    cat "$state/default_smp_affinity" > /proc/irq/default_smp_affinity
    for saved in "$state"/irq/*; do
      cat "$saved" > "/proc/irq/${saved##*/}/smp_affinity_list" 2> /dev/null || true
    done
    for saved in "$state"/freq/*; do
      [[ -e $saved ]] || continue
      cat "$saved" > "/sys/devices/system/cpu/cpu${saved##*/}/cpufreq/scaling_max_freq"
    done
    rm -r "$state"
  fi
}

status() {
  local partition=member
  if [[ -r $bench/cpuset.cpus.partition ]]; then partition=$(cat "$bench/cpuset.cpus.partition"); fi
  local l3=-
  if [[ -d $resctrl/fxdax-bench ]]; then l3=$(sed -n 's/^ *L3://p' $resctrl/fxdax-bench/schemata); fi
  echo "isolation: partition=$partition l3=$l3 workqueues=$(cat /sys/devices/virtual/workqueue/cpumask)"
}

case ${1:-} in
  on) on ;;
  off) off ;;
  status) status ;;
  *) echo "usage: fxjob-isolate on|off|status" >&2; exit 2 ;;
esac

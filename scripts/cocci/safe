# Matches of scripts/cocci's rules in the guest's C that are no bug, each with why, a line each:
# RULE FILE FUNCTION: CODE -- WHY. CODE is the line the rule matched, stripped, the first of a match
# of several lines; FUNCTION the one spatch's hunk names (scripts/cocci-guest.py).
unwoken.cocci device.c cladefs_device_seal_begin: dev->sealing = true; -- the seal begins: the waits on dev->wait are for !sealing, which this makes false, so none is due a wake
unwoken.cocci driver.c vext_find_queues: queue->vq = vqs[i]; -- with queue->closed = false after it, the queues found again as the device opens or resets: vext_close_queues woke every wait on queue->room, each of which saw closed and ended, and the waits are for closed or room, which this makes false
lock-not-held.cocci super.c cladefs_vfs_reconfigure: err = cladefs_vfs_settle_frozen(sb); -- the VFS calls reconfigure with s_umount held (reconfigure_super)
lock-not-held.cocci dax.c cladefs_dax_iomap_write: err = cladefs_dax_dirty(inode, range, first, pages, zero, -- cladefs_dax_get_range returned holding the file's semaphore shared, as its comment says: a lock taken by a callee for its caller, which the rule can't see
guarded-fields.cocci dax.c cladefs_dax_put_region: if (region->mapped) -- its last reference dropped and the region out of the hash, under the regions lock: nothing else can reach it to change mapped
lock-not-held.cocci dax.c cladefs_dax_write_back_keeping: pages += cladefs_dax_range_swap(range, batch[nr].pages); -- after its for (;;) breaks holding the file's semaphore for writing: Coccinelle takes the loop for one that may not run

# libmachine's test kernel: tinyconfig plus what a libmachine guest needs.
# Merged by crates/libmachine/scripts/build-test-guest.sh; every option here is checked to be
# set after the merge, so a dependency the merge drops fails the build.

# Basics: 64-bit, SMP, printk with timestamps (for boot timing).
# tinyconfig allows 2 CPUs; 256 covers libmachine's most vCPUs (254), so
# the kernel never hides vCPUs the machine has.
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=256
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y

# Running under KVM: paravirt clock, and the PVH entry point for ELF vmlinux.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_PVH=y

# ACPI: power off and reset through the FADT's registers, CPUs and the
# I/O APIC from the MADT. ACPI needs PCI: without it ACPICA has no handler
# for the PCI config address space and refuses to load the DSDT.
CONFIG_ACPI=y
CONFIG_PCI=y

# The console: a 16550 on COM1, which the DSDT describes (PNP0501): a
# hardware-reduced ACPI platform has no legacy PIC, so the UART's interrupt
# is only found through ACPI.
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PNP=y
CONFIG_PNPACPI=y
CONFIG_SERIAL_8250_PNP=y

# A bzImage boot waits for decompression: zstd is close to LZ4's speed with a
# better ratio, and its tool is commonly installed.
CONFIG_KERNEL_ZSTD=y

# PCI as libmachine provides it: config space through ECAM only (the MCFG
# table; there are no 0xCF8/0xCFC ports), MSI-X for every device interrupt
# (no INTx: a hardware-reduced platform has no legacy PIC), and the modern
# virtio-PCI transport.
CONFIG_PCI_MMCONFIG=y
CONFIG_PCI_MSI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y

# virtio-rng, which every PC machine has: the kernel takes early entropy
# from it, and init's "devices" action reads /dev/hwrng.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# The VM generation ID (VMGENID), which every PC machine has: a machine
# restored from a snapshot gets a new one, and the vmgenid driver reseeds
# the kernel's RNG from it, so that clones do not draw the same numbers.
CONFIG_VIRT_DRIVERS=y
CONFIG_VMGENID=y

# virtio-vsock, which every PC machine has, for libmachine's guest agent:
# the networking core, the vsock socket family and its virtio transport.
# Futexes for the agent's threads (and any threaded program it runs), and
# Unix sockets, without which the agent (Rust's std) cannot start a
# process: spawning fails with EAFNOSUPPORT.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_FUTEX=y

# virtio-net, for machines with a network (board 13097): IPv4 and the card. The
# address, route and DNS server come from the kernel command line
# (CONFIG_IP_PNP, ip=), which also writes the DNS server to /proc/net/pnp;
# the initramfs links /etc/resolv.conf there. No IPv6: the guest's link is
# IPv4 only, and IPv6 would only send router solicitations nobody answers.
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
# CONFIG_IPV6 is not set

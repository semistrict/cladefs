import os
from collections.abc import Callable, Mapping, Sequence
from types import TracebackType
from typing import Literal

ExitKind = Literal[
    "poweroff", "reset", "stopped", "timed_out", "halt", "shutdown", "unhandled_io", "unhandled_mmio",
    "fail_entry", "internal_error", "other", "closed", "failed",
]

class MachineError(Exception): ...
class GuestBusyError(MachineError): ...

class Exit:
    @property
    def kind(self) -> ExitKind: ...
    @property
    def port(self) -> int | None: ...
    @property
    def addr(self) -> int | None: ...
    @property
    def size(self) -> int | None: ...
    @property
    def write(self) -> bool | None: ...
    @property
    def reason(self) -> int | None: ...
    @property
    def detail(self) -> str | None: ...

class StopHandle:
    def stop(self) -> None: ...

class Registers:
    rax: int
    rbx: int
    rcx: int
    rdx: int
    rsi: int
    rdi: int
    rsp: int
    rbp: int
    r8: int
    r9: int
    r10: int
    r11: int
    r12: int
    r13: int
    r14: int
    r15: int
    rip: int
    rflags: int

StrPath = str | os.PathLike[str]

class ExecResult:
    @property
    def exit_code(self) -> int | None: ...
    @property
    def signal(self) -> int | None: ...
    @property
    def stdout(self) -> bytes: ...
    @property
    def stderr(self) -> bytes: ...

class Process:
    @property
    def pid(self) -> int: ...
    def write_stdin(self, data: bytes) -> None: ...
    def close_stdin(self) -> None: ...
    def signal(self, signal: int) -> None: ...
    def kill(self) -> None: ...
    def read(
        self,
    ) -> tuple[Literal["stdout", "stderr"], bytes] | tuple[Literal["exit"], tuple[int | None, int | None]] | None: ...
    def wait(self) -> ExecResult: ...

class Agent:
    def ping(self, *, timeout: float | None = None) -> None: ...
    def wait_ready(self, timeout: float = 30.0) -> None: ...
    def exec(
        self,
        argv: Sequence[StrPath],
        *,
        env: Mapping[str, str] | None = None,
        cwd: StrPath | None = None,
        stdin: bytes | None = None,
        timeout: float | None = None,
    ) -> ExecResult: ...
    def spawn(
        self,
        argv: Sequence[StrPath],
        *,
        env: Mapping[str, str] | None = None,
        cwd: StrPath | None = None,
        timeout: float | None = None,
    ) -> Process: ...
    def read_file(self, path: StrPath, *, timeout: float | None = None) -> bytes: ...
    def write_file(self, path: StrPath, data: bytes, mode: int = 0o644, *, timeout: float | None = None) -> None: ...

class Vsock:
    @property
    def guest_cid(self) -> int: ...
    def reset_connections(self) -> None: ...

GUEST_ADDR: str
GATEWAY_ADDR: str

Ports = int | tuple[int, int] | str | None

class EgressPolicy:
    def __init__(self) -> None: ...
    @staticmethod
    def allow_all() -> EgressPolicy: ...
    def allow(self, host: str, ports: Ports = None) -> EgressPolicy: ...
    def deny(self, host: str, ports: Ports = None) -> EgressPolicy: ...
    def ask(self, host: str, ports: Ports = None) -> EgressPolicy: ...
    @property
    def rules(self) -> list[tuple[Literal["allow", "deny", "ask"], str, tuple[int, int]]]: ...
    def check(
        self, addr: str, port: int, names: Sequence[str] = (), host_names: Sequence[str] = ()
    ) -> Literal["allow", "deny", "ask"]: ...
    def allows(self, addr: str, port: int, names: Sequence[str] = (), host_names: Sequence[str] = ()) -> bool: ...

class ConnectionRequest:
    @property
    def guest_port(self) -> int: ...
    @property
    def addr(self) -> str: ...
    @property
    def port(self) -> int: ...
    @property
    def names(self) -> list[str]: ...
    @property
    def rule(self) -> int: ...

Decision = bool | Literal["allow", "deny"]
Decider = Callable[[ConnectionRequest], Decision]

class ConnectionRecord:
    @property
    def guest_port(self) -> int: ...
    @property
    def addr(self) -> str: ...
    @property
    def port(self) -> int: ...
    @property
    def names(self) -> list[str]: ...
    @property
    def verdict(self) -> Literal["allow", "deny"]: ...
    @property
    def decided_by(self) -> str: ...
    @property
    def rule(self) -> int | None: ...
    @property
    def connected(self) -> bool: ...
    @property
    def bytes_to_host(self) -> int: ...
    @property
    def bytes_to_guest(self) -> int: ...
    @property
    def started(self) -> float: ...
    @property
    def duration(self) -> float: ...

class NetworkConfig:
    def __init__(
        self,
        policy: EgressPolicy | None = None,
        *,
        hosts: Mapping[str, str | Sequence[str]] | None = None,
        dns_ttl: int = 60,
        log_capacity: int = 1024,
        decider: Decider | None = None,
        decider_timeout: float = 10.0,
        decider_default: Literal["allow", "deny"] = "deny",
    ) -> None: ...
    @property
    def policy(self) -> EgressPolicy: ...
    @property
    def hosts(self) -> dict[str, list[str]]: ...
    @property
    def dns_ttl(self) -> int: ...
    @property
    def log_capacity(self) -> int: ...

class Network:
    @property
    def policy(self) -> EgressPolicy: ...
    def set_policy(self, policy: EgressPolicy) -> None: ...
    @property
    def hosts(self) -> dict[str, list[str]]: ...
    def set_hosts(self, hosts: Mapping[str, str | Sequence[str]]) -> None: ...
    def set_decider(
        self, callback: Decider | None, *, timeout: float = 10.0, default: Literal["allow", "deny"] = "deny"
    ) -> None: ...
    def take_log(self) -> list[ConnectionRecord]: ...
    @property
    def log_capacity(self) -> int: ...
    @property
    def dns_ttl(self) -> int: ...
    def stats(self) -> dict[str, int]: ...

class Machine:
    @staticmethod
    def boot_linux(
        kernel: str | os.PathLike[str],
        initrd: str | os.PathLike[str] | None = None,
        cmdline: str = "",
        *,
        mem_size: int = ...,
        cpu_model: Literal["host", "baseline"] = "host",
        vcpus: int = 1,
        network: EgressPolicy | NetworkConfig | None = None,
    ) -> Machine: ...
    def __init__(
        self, *, mem_size: int = ..., cpu_model: Literal["host", "baseline"] = "host"
    ) -> None: ...
    @property
    def mem_size(self) -> int: ...
    @property
    def cpu_model(self) -> Literal["host", "baseline"]: ...
    @property
    def cpu_fingerprint(self) -> str: ...
    def cpuid(self, function: int, index: int = 0) -> tuple[int, int, int, int] | None: ...
    def load(self, addr: int, data: bytes) -> None: ...
    def read_memory(self, addr: int, length: int) -> bytes: ...
    def set_entry(self, addr: int) -> None: ...
    def run(self, timeout: float | None = None) -> Exit: ...
    def agent(self) -> Agent: ...
    def vsock(self) -> Vsock: ...
    def network(self) -> Network: ...
    def stop_handle(self) -> StopHandle: ...
    def registers(self) -> Registers: ...
    def serial_output(self) -> bytes: ...
    def take_serial_output(self) -> bytes: ...

ProcessEvent = tuple[Literal["stdout", "stderr"], bytes] | tuple[Literal["exit"], tuple[int | None, int | None]]

class AsyncProcess:
    @property
    def pid(self) -> int: ...
    async def write_stdin(self, data: bytes) -> None: ...
    async def close_stdin(self) -> None: ...
    async def signal(self, signal: int) -> None: ...
    async def kill(self) -> None: ...
    async def read(self) -> ProcessEvent | None: ...
    async def wait(self) -> ExecResult: ...

class AsyncSandbox:
    @staticmethod
    async def create(
        kernel: StrPath,
        initrd: StrPath | None = None,
        cmdline: str = "",
        *,
        mem_size: int = ...,
        cpu_model: Literal["host", "baseline"] = "host",
        vcpus: int = 1,
        network: EgressPolicy | NetworkConfig | None = None,
        ready_timeout: float = 30.0,
        timeout: float | None = None,
    ) -> AsyncSandbox: ...
    @staticmethod
    async def restore(
        snapshot: Snapshot,
        *,
        ready_timeout: float = 30.0,
        timeout: float | None = None,
    ) -> AsyncSandbox: ...
    async def snapshot(self, path: StrPath) -> Snapshot: ...
    async def suspend(self, dir: StrPath) -> None: ...
    async def resume(self) -> None: ...
    @property
    def suspended(self) -> bool: ...
    async def exec(
        self,
        argv: Sequence[StrPath],
        *,
        env: Mapping[str, str] | None = None,
        cwd: StrPath | None = None,
        stdin: bytes | None = None,
    ) -> ExecResult: ...
    async def spawn(
        self,
        argv: Sequence[StrPath],
        *,
        env: Mapping[str, str] | None = None,
        cwd: StrPath | None = None,
    ) -> AsyncProcess: ...
    async def read_file(self, path: StrPath) -> bytes: ...
    async def write_file(self, path: StrPath, data: bytes, mode: int = 0o644) -> None: ...
    async def copy_to_guest(self, src: StrPath, dst: StrPath) -> None: ...
    async def copy_from_guest(self, src: StrPath, dst: StrPath) -> None: ...
    async def wait(self) -> Exit: ...
    async def close(self) -> Exit: ...
    @property
    def ended(self) -> Exit | None: ...
    def console_output(self) -> bytes: ...
    def agent(self) -> Agent: ...
    def network(self) -> Network: ...
    async def __aenter__(self) -> AsyncSandbox: ...
    async def __aexit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        traceback: TracebackType | None,
    ) -> bool: ...

SNAPSHOT_FORMAT_VERSION: int

class Snapshot:
    def __init__(self, path: str | os.PathLike[str]) -> None: ...
    @staticmethod
    def take(machine: Machine, path: str | os.PathLike[str]) -> Snapshot: ...
    def restore(
        self,
        *,
        mem_size: int | None = None,
        cpu_model: str | None = None,
        vcpus: int | None = None,
    ) -> Machine: ...
    @property
    def path(self) -> os.PathLike[str]: ...
    @property
    def mem_size(self) -> int: ...
    @property
    def vcpus(self) -> int: ...
    @property
    def cpu_model(self) -> str: ...
    @property
    def cpu_fingerprint(self) -> str: ...

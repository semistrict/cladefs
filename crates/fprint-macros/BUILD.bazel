load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("//tools/bazel:rust.bzl", "cladefs_rust_proc_macro")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(
    name = "crate_files",
    srcs = glob(["Cargo.toml", "src/**/*.rs"]),
)

cladefs_rust_proc_macro(
    name = "fprint_macros",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "macros",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True),
)

load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("//tools/bazel:rust.bzl", "cladefs_rust_library", "cladefs_rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(
    name = "crate_files",
    srcs = glob(["Cargo.toml", "src/**/*", "tests/**/*"], allow_empty = True),
)

_COMMON_DEPS = [
    "//crates/cladefs",
    "//crates/formats",
    "//crates/fprint",
]

_TEST_DEPS = [
    "//crates/cladefs:cladefs_tests_kms",
    "//crates/formats",
    "//crates/fprint",
]

cladefs_rust_library(
    name = "virtio_extent",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = _COMMON_DEPS + all_crate_deps(normal = True),
)

cladefs_rust_library(
    name = "virtio_extent_for_test",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "virtio_extent",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = _TEST_DEPS + all_crate_deps(normal = True),
)

cladefs_rust_library(
    name = "virtio_extent_loom",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["loom"],
    crate_name = "virtio_extent",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = _COMMON_DEPS + [
        "@crates//:loom",
    ] + all_crate_deps(normal = True),
)

cladefs_rust_test(
    name = "virtio_extent_test",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    crate = ":virtio_extent",
    data = [
        "//:Cargo.lock",
        "//formats:all",
    ],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

cladefs_rust_test(
    name = "virtio_extent_loom_test",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    args = ["loom::"],
    crate = ":virtio_extent_loom",
    crate_features = ["loom"],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    tags = ["loom"],
    deps = all_crate_deps(normal_dev = True),
)

cladefs_rust_test(
    name = "daemon_test",
    srcs = ["tests/daemon.rs"],
    aliases = aliases(normal = True, normal_dev = True),
    isolated = True,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":virtio_extent_for_test",
    ] + _TEST_DEPS + all_crate_deps(normal = True, normal_dev = True),
)

load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("//tools/bazel:rust.bzl", "cladefs_rust_binary", "cladefs_rust_library", "cladefs_rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(
    name = "crate_files",
    srcs = glob(["Cargo.toml", "src/**/*", "tests/**/*"], allow_empty = True),
)

cladefs_rust_library(
    name = "fxfs_automount",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**/*.rs"],
    ),
    aliases = aliases(),
    crate_name = "fxfs_automount",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True),
)

cladefs_rust_binary(
    name = "fxfs-automount",
    srcs = ["src/bin/fxfs-automount.rs"],
    aliases = aliases(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [":fxfs_automount"] + all_crate_deps(normal = True),
)

cladefs_rust_binary(
    name = "git-remote-fxfs",
    srcs = ["src/bin/git-remote-fxfs.rs"],
    aliases = aliases(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = [":fxfs_automount"] + all_crate_deps(normal = True),
)

cladefs_rust_test(
    name = "fxfs_automount_test",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    crate = ":fxfs_automount",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

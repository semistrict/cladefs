"""Bazel targets for crates/fxfs/fuzz (libFuzzer targets, require nightly + sanitizer)."""

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

filegroup(
    name = "fuzz_targets",
    srcs = glob(["fuzz_targets/**/*.rs"]),
)

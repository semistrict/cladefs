load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("//tools/bazel:rust.bzl", "cladefs_rust_library", "cladefs_rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

filegroup(
    name = "crate_files",
    srcs = glob(["Cargo.toml", "src/**/*", "tests/**/*"], allow_empty = True),
)

_COMMON_DEPS = [
    "//crates/formats",
    "//crates/storage_device",
]

cladefs_rust_library(
    name = "block_device",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = _COMMON_DEPS + all_crate_deps(normal = True),
)

cladefs_rust_library(
    name = "block_device_testing",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["testing"],
    crate_name = "block_device",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = _COMMON_DEPS + all_crate_deps(normal = True),
)

cladefs_rust_test(
    name = "block_device_test",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    crate = ":block_device_testing",
    crate_features = ["testing"],
    data = [
        "//:Cargo.lock",
        "//formats:all",
    ],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

[
    cladefs_rust_test(
        name = test_name + "_test",
        srcs = ["tests/" + test_name + ".rs"],
        aliases = aliases(normal = True, normal_dev = True),
        proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
        deps = [
            ":block_device_testing",
        ] + _COMMON_DEPS + all_crate_deps(normal = True, normal_dev = True),
    )
    for test_name in [
        "crash",
        "memory",
        "model",
        "operations",
    ]
]

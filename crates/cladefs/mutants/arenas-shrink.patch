# Arenas' objects aren't sealed against shrinking: a VM process shrinks its tenant's, which it may
# write, and the daemon's next access to a page past its new end faults (SIGBUS), the daemon gone,
# every tenant's VMs with it (TASK-149.17).
# Kind: daemon crashed
# Killer: cladefsd::tests::hostile::vm_processes_shrinking_their_memory_crash_nothing
--- a/crates/cladefs/src/slabs/object.rs
+++ b/crates/cladefs/src/slabs/object.rs
@@ -202,7 +202,7 @@
     }
     // SAFETY: `fd` was just created and is owned here.
     let fd = unsafe { OwnedFd::from_raw_fd(fd) };
-    let seals = libc::F_SEAL_SHRINK | libc::F_SEAL_SEAL;
+    let seals = libc::F_SEAL_SEAL;
     // SAFETY: seals the object just made.
     if unsafe { libc::fcntl(fd.as_raw_fd(), libc::F_ADD_SEALS, seals) } != 0 {
         return Err(io::Error::last_os_error());

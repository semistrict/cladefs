    name = "crates",
    cargo_lockfile = "@cladefs_cargo_manifests//:Cargo.lock",
    manifests = ["@cladefs_cargo_manifests//:Cargo.toml"],
    supported_platform_triples = _SUPPORTED_TRIPLES,

    patches = [
        "//guest/linux:patches/0010-dax-read-replaces-no-entry-naming-its-page.patch",
        "//guest/linux:patches/0011-dax-a-folio-put-for-good-keeps-no-share-count.patch",
    ],
)
use_repo(amazon_linux_kernel, "amazon_linux_kernel", "amazon_linux_sim_kernel")


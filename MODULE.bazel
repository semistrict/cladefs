# Python Toolchain (for scripts/tests and repo checks)
# -----------------------------------------------------------------------------
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

# -----------------------------------------------------------------------------
# Node.js Toolchain & pnpm Lockfile Packages for guide/ (aspect_rules_js)
# -----------------------------------------------------------------------------
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.2.0")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "guide_npm",
    pnpm_lock = "//guide:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "guide_npm")

# -----------------------------------------------------------------------------
# Pinned Amazon Linux 6.18 Kernel Sources for guest/sim and guest/linux
# -----------------------------------------------------------------------------

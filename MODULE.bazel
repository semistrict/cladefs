# -----------------------------------------------------------------------------
# Rust Toolchains (pinned to rust-toolchain.toml: 1.100.0, edition 2024)
# Replace Linux repository sets so glibc targets require //tools/platforms:gnu
# and musl targets require //tools/platforms:musl (zero ambiguity in toolchain
# resolution on both Linux and macOS hosts).
# -----------------------------------------------------------------------------
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")

[
    rust.repository_set(
        name = repo_name,
        edition = "2024",
        exec_compatible_with = host_constraints,
        exec_triple = host_triple,
        target_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:x86_64",
            "//tools/platforms:gnu",
        ],
        target_triple = "x86_64-unknown-linux-gnu",
        versions = ["1.100.0"],
    )
    for repo_name, host_triple, host_constraints in [
        ("rust_linux_x86_64", "x86_64-unknown-linux-gnu", ["@platforms//os:linux", "@platforms//cpu:x86_64"]),
        ("rust_linux_aarch64", "aarch64-unknown-linux-gnu", ["@platforms//os:linux", "@platforms//cpu:aarch64"]),
    ]
]

[
    rust.repository_set(
        name = repo_name,
        target_compatible_with = target_constraints,
        target_triple = target_triple,
    )
    for repo_name in [
        "rust_linux_x86_64",
        "rust_linux_aarch64",
    ]
    for target_triple, target_constraints in [
        ("aarch64-unknown-linux-gnu", ["@platforms//os:linux", "@platforms//cpu:aarch64", "//tools/platforms:gnu"]),
        ("x86_64-unknown-linux-musl", ["@platforms//os:linux", "@platforms//cpu:x86_64", "//tools/platforms:musl"]),
        ("aarch64-unknown-linux-musl", ["@platforms//os:linux", "@platforms//cpu:aarch64", "//tools/platforms:musl"]),
    ]
]

# Also allow macOS ARM64 hosts to cross-compile to static Linux musl.
rust.repository_set(
    name = "rust_musl_macos_aarch64",
    edition = "2024",
    exec_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
    exec_triple = "aarch64-apple-darwin",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "//tools/platforms:musl",
    ],
    target_triple = "x86_64-unknown-linux-musl",
    versions = ["1.100.0"],
)

rust.repository_set(
    name = "rust_musl_macos_aarch64",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        "//tools/platforms:musl",
    ],
    target_triple = "aarch64-unknown-linux-musl",
)

rust.toolchain(
    edition = "2024",
    versions = ["1.100.0"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

# -----------------------------------------------------------------------------
# Musl Static C/C++ Toolchains (x86_64-unknown-linux-musl, aarch64-unknown-linux-musl)
# Scoped exclusively to //tools/platforms:musl so default Linux glibc builds use
# the host glibc CC toolchain.
# -----------------------------------------------------------------------------
toolchains_musl = use_extension("@toolchains_musl//:toolchains_musl.bzl", "toolchains_musl")
toolchains_musl.config(
    extra_target_compatible_with = ["//tools/platforms:musl"],
)
use_repo(toolchains_musl, "musl_toolchains_hub")
register_toolchains("@musl_toolchains_hub//:all")


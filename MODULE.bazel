bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "rules_shell", version = "0.10.0")
bazel_dep(name = "rules_python", version = "2.5.1")
bazel_dep(name = "rules_java", version = "9.9.0")

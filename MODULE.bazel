# Control fail/failpoints by build config (off in --config=release / --config=musl-*, on in
# dev tests and --config=sim) to satisfy bucket_cell's TASK-320 compile-time guard, and wire
# madsim / madsim-tokio / madsim-tonic's cfg(madsim) dependencies only when --config=madsim.
# The rust_library targets live in //tools/bazel/BUILD.bazel so additive_build_file_content
# only emits native builtins (filegroup, exports_files, alias) with no load() statements.
[
    crate.annotation(
        additive_build_file_content = """
exports_files(["src/lib.rs"])
filegroup(name = "crate_srcs", srcs = glob(["**/*.rs"]))
filegroup(name = "crate_compile_data", srcs = glob(["**"], exclude = ["**/* *", "BUILD", "BUILD.bazel", "WORKSPACE", "WORKSPACE.bazel"]))
""",
        crate = crate_name,
        extra_aliased_targets = {
            crate_name + "-compile-data": "crate_compile_data",
            crate_name + "-env": "cargo_toml_env_vars",
            crate_name + "-lib-rs": "src/lib.rs",
            crate_name + "-srcs": "crate_srcs",
        },
        override_target_lib = "//tools/bazel:" + override_name,
        repositories = ["crates"],
    )
    for crate_name, override_name in [
        ("fail", "fail_lib"),
        ("madsim", "madsim_lib"),
        ("madsim-tokio", "madsim_tokio_lib"),
        ("madsim-tonic", "madsim_tonic_lib"),
    ]
]

# Guest E2E test harness crates not present in root Cargo.lock (pinned to guest/tests/Cargo.toml).
crate.spec(
    features = ["derive"],
    package = "clap",
    repositories = ["guest_tests_crates"],
    version = "=4.5.27",
)
crate.spec(
    features = [
        "fs",
        "ioctl",
        "process",
        "resource",
        "signal",
        "socket",
        "user",
    ],
    package = "nix",
    repositories = ["guest_tests_crates"],
    version = "=0.29.0",
)
crate.spec(
    package = "tempdir",
    repositories = ["guest_tests_crates"],
    version = "=0.3.7",
)
crate.from_specs(
    name = "guest_tests_crates",
    supported_platform_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-musl",
    ],
)

# Firecracker VMM crate universe (resolved from vendor/firecracker/Cargo.lock without touching the submodule).
crate.from_cargo(
    name = "firecracker_crates",
    cargo_lockfile = "@firecracker_cargo_manifests//:Cargo.lock",
    manifests = ["@firecracker_cargo_manifests//:Cargo.toml"],
    supported_platform_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-musl",
    ],
)

# Unify serde and serde_core between @firecracker_crates and @crates (both pinned to 1.0.229)
# so Firecracker's ExtentState can embed virtio_extent::persist::State with a single serde crate.
crate.annotation(
    crate = "serde",
    override_target_lib = "@crates//:serde",
    repositories = ["firecracker_crates"],
)
crate.annotation(
    crate = "serde_core",
    override_target_lib = "@crates//:serde_core",
    repositories = ["firecracker_crates"],
)

use_repo(crate, "crates", "firecracker_crates", "guest_tests_crates")


{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"$CLAUDE_PROJECT_DIR/.agent-role\" || exit 0; exec python3 \"$CLAUDE_PROJECT_DIR/scripts/agent-role-guard.py\""
          }
        ]
      }
    ]
  }
}

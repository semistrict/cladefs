"""Bzlmod repository extension for the pinned Amazon Linux 6.18 guest kernel sources."""

# Matches scripts/lib/guest-kernel-release.sh (board 8601).
_KERNEL_TAG = "kernel6.18-6.18.62-127.179.amzn2023"
_KERNEL_COMMIT = "b7522fb67989bd879de78486e9e253fd2f21f1dd"
_KERNEL_URL = "https://github.com/amazonlinux/linux.git"
_KERNEL_BUILD_DATE = "2026-04-08T00:00:00Z"

_SIM_BUILD_FILE = """# Generated by //tools/bazel:kernel.bzl
package(default_visibility = ["//visibility:public"])

exports_files([
    "fs/dax.c",
    "fs/iomap/iter.c",
    "lib/xarray.c",
    "lib/genalloc.c",
    "lib/radix-tree.h",
    "include/linux/kconfig.h",
    "include/linux/list.h",
    "include/linux/poison.h",
    "include/linux/hash.h",
    "include/linux/hashtable.h",
    "include/linux/rculist.h",
    "include/linux/xarray.h",
    "include/linux/iomap.h",
    "include/linux/dax.h",
    "include/linux/genalloc.h",
    "include/linux/wait.h",
    "include/linux/wait_bit.h",
    "include/trace/events/fs_dax.h",
])

filegroup(
    name = "sim_real_sources",
    srcs = [
        "fs/dax.c",
        "fs/iomap/iter.c",
        "lib/xarray.c",
        "lib/genalloc.c",
    ],
)

filegroup(
    name = "sim_real_headers",
    srcs = [
        "include/linux/kconfig.h",
        "include/linux/list.h",
        "include/linux/poison.h",
        "include/linux/hash.h",
        "include/linux/hashtable.h",
        "include/linux/rculist.h",
        "include/linux/xarray.h",
        "include/linux/iomap.h",
        "include/linux/dax.h",
        "include/linux/genalloc.h",
        "include/linux/wait.h",
        "include/linux/wait_bit.h",
        "include/trace/events/fs_dax.h",
    ],
)

filegroup(
    name = "sim_private_headers",
    srcs = glob([
        "fs/iomap/*.h",
        "lib/*.h",
    ]),
)
"""

_FULL_BUILD_FILE = """# Generated by //tools/bazel:kernel.bzl
package(default_visibility = ["//visibility:public"])

exports_files(["kernel.tar"])
"""

def _sim_kernel_repo_impl(rctx):
    patches = [rctx.path(p) for p in rctx.attr.patches]
    patch_cmds = "\n".join([
        'git -C . apply "{}"'.format(str(p))
        for p in patches
    ])
    script = """set -euo pipefail
git clone -q --depth 1 --filter=blob:none --sparse --branch "{tag}" "{url}" .
named="$(git rev-parse --verify --quiet "{tag}^{{commit}}")"
if [[ "$named" != "{commit}" ]]; then
    echo "{tag} names $named, not {commit}: refused" >&2
    exit 1
fi
git sparse-checkout set --no-cone /fs/dax.c /fs/iomap/ /include/ /lib/xarray.c /lib/radix-tree.h /lib/genalloc.c
{patch_cmds}
rm -rf .git
""".format(
        tag = _KERNEL_TAG,
        commit = _KERNEL_COMMIT,
        url = _KERNEL_URL,
        patch_cmds = patch_cmds,
    )
    res = rctx.execute(["bash", "-c", script], timeout = 600)
    if res.return_code != 0:
        fail("Failed to fetch/patch amazon_linux_sim_kernel:\nstdout:\n{}\nstderr:\n{}".format(
            res.stdout,
            res.stderr,
        ))
    rctx.file("BUILD.bazel", _SIM_BUILD_FILE)

_sim_kernel_repo = repository_rule(
    implementation = _sim_kernel_repo_impl,
    attrs = {
        "patches": attr.label_list(allow_files = [".patch"]),
    },
    doc = "Fetches and patches the sparse Amazon Linux 6.18 tree for guest/sim.",
)

def _full_kernel_repo_impl(rctx):
    # Fetches the pinned Amazon Linux 6.18 source tarball once into Bazel's repository cache,
    # verifies the exact commit (board 8601), and archives it as a single hermetic tar artifact
    # so Bazel does not have to track 80,000 individual kernel files in Skyframe.
    script = """set -euo pipefail
git clone -q --depth 1 --branch "{tag}" "{url}" src
named="$(git -C src rev-parse --verify --quiet "{tag}^{{commit}}")"
if [[ "$named" != "{commit}" ]]; then
    echo "{tag} names $named, not {commit}: refused" >&2
    exit 1
fi
git -C src archive --format=tar --output="$PWD/kernel.tar" HEAD
rm -rf src
""".format(
        tag = _KERNEL_TAG,
        commit = _KERNEL_COMMIT,
        url = _KERNEL_URL,
    )
    res = rctx.execute(["bash", "-c", script], timeout = 1200)
    if res.return_code != 0:
        fail("Failed to fetch amazon_linux_kernel:\nstdout:\n{}\nstderr:\n{}".format(
            res.stdout,
            res.stderr,
        ))
    rctx.file("BUILD.bazel", _FULL_BUILD_FILE)

_full_kernel_repo = repository_rule(
    implementation = _full_kernel_repo_impl,
    attrs = {},
    doc = "Fetches and verifies the pinned Amazon Linux 6.18 kernel source archive for guest/linux.",
)

def _kernel_ext_impl(mctx):
    sim_patches = []
    for mod in mctx.modules:
        for cfg in mod.tags.sim_kernel:
            sim_patches = cfg.patches
    _sim_kernel_repo(
        name = "amazon_linux_sim_kernel",
        patches = sim_patches,
    )
    _full_kernel_repo(
        name = "amazon_linux_kernel",
    )

_sim_kernel_tag = tag_class(
    attrs = {
        "patches": attr.label_list(allow_files = [".patch"]),
    },
)

amazon_linux_kernel = module_extension(
    implementation = _kernel_ext_impl,
    tag_classes = {
        "sim_kernel": _sim_kernel_tag,
    },
)

+    let probes = [
+        KernelProbe::new("ptrace", libc::SYS_ptrace),
+        KernelProbe::new("process_vm_writev", libc::SYS_process_vm_writev),
+        KernelProbe::new("bpf", libc::SYS_bpf),
+        KernelProbe::new("perf_event_open", libc::SYS_perf_event_open),
+        KernelProbe::new("io_uring_setup", libc::SYS_io_uring_setup),
+        KernelProbe::new("io_uring_enter", libc::SYS_io_uring_enter),
+        KernelProbe::new("io_uring_register", libc::SYS_io_uring_register),
+        KernelProbe::new("userfaultfd", libc::SYS_userfaultfd),
+        KernelProbe::new("mount", libc::SYS_mount),
+        KernelProbe::new("setns", libc::SYS_setns),
+        KernelProbe::new("unshare", libc::SYS_unshare),
+        KernelProbe::new("kcmp", libc::SYS_kcmp),
+        KernelProbe::new("pidfd_open", libc::SYS_pidfd_open),
+        KernelProbe::new("pidfd_getfd", libc::SYS_pidfd_getfd),
+        KernelProbe::new("pidfd_send_signal", libc::SYS_pidfd_send_signal),
+        KernelProbe::new("execve", libc::SYS_execve),
+        KernelProbe::new("execveat", libc::SYS_execveat),
+        KernelProbe::new("init_module", libc::SYS_init_module),
+        KernelProbe::new("finit_module", libc::SYS_finit_module),
+        KernelProbe::new("delete_module", libc::SYS_delete_module),
+        KernelProbe::new("reboot", libc::SYS_reboot),
+        KernelProbe::new("kexec_load", libc::SYS_kexec_load),
+        KernelProbe::new("open_by_handle_at", libc::SYS_open_by_handle_at),
+        KernelProbe::new("name_to_handle_at", libc::SYS_name_to_handle_at),
+        KernelProbe::new("move_mount", libc::SYS_move_mount),
+        KernelProbe::new("fsopen", libc::SYS_fsopen),
+        KernelProbe::new("fsconfig", libc::SYS_fsconfig),
+        KernelProbe::new("fsmount", libc::SYS_fsmount),
+        KernelProbe::new("pivot_root", libc::SYS_pivot_root),
+        KernelProbe::new("swapon", libc::SYS_swapon),
+        KernelProbe::new("swapoff", libc::SYS_swapoff),
+        KernelProbe::new("quotactl", libc::SYS_quotactl),
+        KernelProbe::new("memfd_secret", libc::SYS_memfd_secret),
+        KernelProbe::new("process_madvise", libc::SYS_process_madvise),
+        KernelProbe::new("clone3", libc::SYS_clone3),
+        KernelProbe::ioctl("KVM_CREATE_VM on vmm", "vmm", KVM_CREATE_VM, "/dev/kvm"),
+        KernelProbe::ioctl("KVM_CREATE_VM on vcpu", "vcpu", KVM_CREATE_VM, "/dev/kvm"),
+    ];
+    let mut reached: Vec<&str> =
+        probes.iter().filter(|probe| reached_kernel(probe)).map(|probe| probe.name).collect();
+    if io_uring_is_usable() {
+        reached.push("a valid io_uring, io_uring_register and io_uring_enter");
+    }
+    assert!(reached.is_empty(), "these escape attempts reached the host kernel: {reached:?}");
+    const UFFDIO_API: libc::c_ulong = 0xc028aa03;
+    let api = KernelProbe::ioctl("UFFDIO_API", "vmm", UFFDIO_API, "/dev/userfaultfd");
+    assert!(reached_kernel(&api), "the positive control did not reach UFFDIO_API");
+}

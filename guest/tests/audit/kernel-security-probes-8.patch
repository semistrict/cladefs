+/// Security-review fixture: an unshared restore is refused before any source I/O or host mutation,
+/// not after syncing the victim and recovering its version into the daemon's kept-store directory.
+#[test]
+fn an_unshared_restore_has_no_effect_before_its_refusal() {
+    let dir = tempfile::tempdir().unwrap();
+    let (mut here, mut there) = (Host::new(dir.path(), "here"), Host::new(dir.path(), "there"));
+    let victim = here.acme.join("victim");
+    let vm = CellClient::connect(&here.socket, &victim, CAPACITY).unwrap();
+    write(&vm, &pattern(1), b"victim");
+    let version = vm.make_version().unwrap();
+    let extent = ExtentId { cell: vm.cell(), sequence: 2 };
+    let uncommitted = vec![0x5a; 64 << 10];
+    vm.write(extent, 0, &[VolatileSlice::from(&uncommitted[..])]).unwrap();
+    let before = here.daemon.stat(&victim).unwrap().committed;
+    let kept = std::env::temp_dir()
+        .join(format!("cladefs-versions-{}", std::process::id()))
+        .join(format!("{:x}.{:x}.{:x}", version.tenant, version.cell, version.version));
+    assert!(!kept.exists(), "the probe began with a recovered version at {}", kept.display());
+
+    let globex = dir.path().join("there/globex");
+    std::fs::create_dir(&globex).unwrap();
+    let socket = there.daemon.grant(2, &globex, None).unwrap();
+    let refused = restore(&socket, &globex.join("refused"), version);
+    assert_eq!(refused.err().unwrap(), Some(Errno::EACCES));
+    let after = here.daemon.stat(&victim).unwrap().committed;
+    assert_eq!(after, before, "the refused restore synced the victim's live writer");
+    assert!(!kept.exists(), "the refused restore recovered a version at {}", kept.display());
+}

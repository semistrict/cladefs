+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::future::Future as _;
+
+    /// Security-review fixture: a full batch of large requests must meet backpressure before each
+    /// payload is gathered into the VMM's heap, not after every one has allocated a private copy.
+    #[test]
+    fn large_writes_waiting_for_replies_do_not_gather_unbounded_payloads() {
+        const WRITES: usize = 32;
+        const LEN: usize = 8 << 20;
+        let (stream, mut daemon) = UnixStream::pair().unwrap();
+        let client = Client::start(stream).unwrap();
+        let (transfer, _area) = Transfer::make().unwrap();
+        let store = CellClient {
+            client,
+            cell: 1,
+            memories: Vec::new(),
+            faults: Mutex::new(None),
+            read_only: false,
+            transfer: Arc::new(transfer),
+            copying: Default::default(),
+            max_map_count: None,
+        };
+        // The daemon consumes every request but answers none, as a stalled connection's does.
+        let reading = std::thread::spawn(move || {
+            use std::io::Read as _;
+            let mut buf = [0; 64 << 10];
+            while let Ok(n) = daemon.read(&mut buf) {
+                if n == 0 {
+                    break;
+                }
+            }
+        });
+        let data = vec![0x5a; LEN];
+        let before = crate::heap::held();
+        let buffers = [VolatileSlice::from(&data[..])];
+        let mut writes = Vec::new();
+        for sequence in 0..WRITES as u64 {
+            let extent = ExtentId { cell: store.cell, sequence };
+            writes.push(Box::pin(store.write_with_barriers_async(
+                extent,
+                0,
+                &buffers,
+                WriteBarriers::default(),
+            )));
+        }
+        // Poll each once: every request is now in flight and none can complete.
+        futures::executor::block_on(futures::future::poll_fn(|cx| {
+            for write in &mut writes {
+                assert!(write.as_mut().poll(cx).is_pending());
+            }
+            std::task::Poll::Ready(())
+        }));
+        let held = crate::heap::held().saturating_sub(before);
+        store.client.close();
+        drop(writes);
+        drop(store);
+        reading.join().unwrap();
+        assert!(held < 32 << 20, "{held} bytes gathered for {WRITES} unanswered {LEN}-byte writes");
+    }
+}

+/// Security-review fixture: an attempted escape into a host kernel interface, from a thread under
+/// Firecracker's real filter. `fd` is opened before confinement, as the jailer opens the VM's devices.
+#[derive(Clone, Copy)]
+struct KernelProbe {
+    name: &'static str,
+    thread: &'static str,
+    nr: libc::c_long,
+    args: [u64; 6],
+    fd: Option<&'static str>,
+}
+
+impl KernelProbe {
+    const fn new(name: &'static str, nr: libc::c_long) -> Self {
+        Self { name, thread: "vmm", nr, args: [0; 6], fd: None }
+    }
+
+    const fn ioctl(
+        name: &'static str,
+        thread: &'static str,
+        request: libc::c_ulong,
+        fd: &'static str,
+    ) -> Self {
+        Self {
+            name,
+            thread,
+            nr: libc::SYS_ioctl,
+            args: [0, request as u64, 0, 0, 0, 0],
+            fd: Some(fd),
+        }
+    }
+}
+
+/// Whether `probe` reached the kernel rather than dying of SIGSYS. Every potentially dangerous call
+/// is made, not inferred from the JSON. The child does no allocation after fork; an allowed call's
+/// own errno is immaterial: it lived, which is what this probe distinguishes.
+fn reached_kernel(probe: &KernelProbe) -> bool {
+    let program = production_filter(probe.thread);
+    let device = probe.fd.map(std::fs::File::open).transpose().unwrap();
+    let fd = device.as_ref().map_or(-1, AsRawFd::as_raw_fd);
+    // SAFETY: The parent built everything the child needs. The child makes only plain system calls.
+    let pid = unsafe { libc::fork() };
+    assert!(pid >= 0, "fork: {}", std::io::Error::last_os_error());
+    if pid == 0 {
+        // SAFETY: Plain system calls, and the program outlives this child.
+        unsafe {
+            if libc::prctl(libc::PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0 {
+                libc::_exit(100);
+            }
+            let mut program = libc::sock_fprog {
+                len: u16::try_from(program.len()).unwrap(),
+                filter: program.as_ptr().cast_mut(),
+            };
+            if libc::syscall(libc::SYS_seccomp, libc::SECCOMP_SET_MODE_FILTER, 0, &mut program) != 0
+            {
+                libc::_exit(101);
+            }
+            let a = probe.args;
+            libc::syscall(
+                probe.nr,
+                if probe.fd.is_some() { fd as u64 } else { a[0] },
+                a[1],
+                a[2],
+                a[3],
+                a[4],
+                a[5],
+            );
+            libc::_exit(0);
+        }
+    }
+    let mut status = 0;
+    // SAFETY: Waits for the child just forked.
+    assert_eq!(unsafe { libc::waitpid(pid, &mut status, 0) }, pid);
+    !(libc::WIFSIGNALED(status) && libc::WTERMSIG(status) == libc::SIGSYS)
+}
+
+/// The kernel's `io_uring_params`, for a valid small ring rather than an invalid-argument probe.
+#[repr(C)]
+struct IoUringParams {
+    sq_entries: u32,
+    cq_entries: u32,
+    flags: u32,
+    sq_thread_cpu: u32,
+    sq_thread_idle: u32,
+    features: u32,
+    wq_fd: u32,
+    reserved: [u32; 3],
+    sq_offsets: [u32; 10],
+    cq_offsets: [u32; 10],
+}
+
+/// Whether a real two-entry ring can be created, registered and entered under the VMM filter.
+fn io_uring_is_usable() -> bool {
+    let program = production_filter("vmm");
+    // SAFETY: The child makes only plain system calls with a valid params object.
+    let pid = unsafe { libc::fork() };
+    assert!(pid >= 0);
+    if pid == 0 {
+        // SAFETY: As in reached_kernel, the program outlives the child.
+        unsafe {
+            if libc::prctl(libc::PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0 {
+                libc::_exit(100);
+            }
+            let mut program = libc::sock_fprog {
+                len: u16::try_from(program.len()).unwrap(),
+                filter: program.as_ptr().cast_mut(),
+            };
+            if libc::syscall(libc::SYS_seccomp, libc::SECCOMP_SET_MODE_FILTER, 0, &mut program) != 0
+            {
+                libc::_exit(101);
+            }
+            let mut params: IoUringParams = std::mem::zeroed();
+            params.sq_entries = 2;
+            let ring = libc::syscall(libc::SYS_io_uring_setup, 2, &mut params);
+            if ring < 0 {
+                libc::_exit(1);
+            }
+            // Each must reach the kernel; its own EINVAL is immaterial. No real request is submitted.
+            libc::syscall(libc::SYS_io_uring_register, ring, 0, 0, 0);
+            libc::syscall(libc::SYS_io_uring_enter, ring, 0, 0, 0, 0, 0);
+            libc::close(ring as i32);
+            libc::_exit(0);
+        }
+    }
+    let mut status = 0;
+    // SAFETY: Waits for the child just forked.
+    assert_eq!(unsafe { libc::waitpid(pid, &mut status, 0) }, pid);
+    libc::WIFEXITED(status) && libc::WEXITSTATUS(status) == 0
+}

+/// A FIEMAP result buffer can span several metadata batches, then fill before EOF.
+/// Resume from the end of its last extent. Every gap must survive both boundaries.
+pub(super) fn test_sparse_extent_batches() {
+    const PAGE: u64 = 4096;
+    const DISTANT: u64 = 1 << 30;
+    const CAPACITY: usize = 258;
+    const FIEMAP: libc::c_ulong = 0xc020660b;
+    const LAST: u32 = 1;
+
+    let name = path("audit-sparse-batches");
+    let file = fs::File::create_new(&name).unwrap();
+    let offsets: Vec<u64> = (0..260).map(|i| 2 * PAGE * i).chain([DISTANT]).collect();
+    for &offset in &offsets {
+        file.write_all_at(&[1; PAGE as usize], offset).unwrap();
+    }
+    file.sync_all().unwrap();
+    let fd = file.as_raw_fd();
+    let seek = |offset, whence| unsafe { libc::lseek(fd, offset as i64, whence) };
+    assert_eq!(seek(DISTANT - PAGE, libc::SEEK_DATA), DISTANT as i64);
+    assert_eq!(seek(DISTANT - PAGE, libc::SEEK_HOLE), (DISTANT - PAGE) as i64);
+    assert_eq!(seek(DISTANT, libc::SEEK_HOLE), (DISTANT + PAGE) as i64);
+
+    let mut start = 0;
+    for expected in offsets.chunks(CAPACITY) {
+        // struct fiemap followed by CAPACITY 56-byte fiemap_extents.
+        let mut buf = vec![0u64; 4 + CAPACITY * 7];
+        buf[0] = start;
+        buf[1] = u64::MAX;
+        buf[3] = CAPACITY as u64;
+        let ret = unsafe { libc::ioctl(fd, FIEMAP as _, buf.as_mut_ptr()) };
+        assert_eq!(ret, 0, "FIEMAP from {start}: {}", std::io::Error::last_os_error());
+        assert_eq!((buf[2] >> 32) as usize, expected.len());
+        for (&offset, extent) in expected.iter().zip(buf[4..].chunks_exact(7)) {
+            assert_eq!((extent[0], extent[2]), (offset, PAGE));
+            assert_eq!((extent[5] as u32 & LAST) != 0, offset == DISTANT);
+            start = extent[0] + extent[2];
+        }
+    }
+    drop(file);
+    fs::remove_file(name).unwrap();
+}

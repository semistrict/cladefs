+//! Registered by guest/tests/audit/guest-probes.patch in the instrumented guest only.
+
+use super::*;
+use std::os::unix::fs::FileExt;
+
+fn param(name: &str) -> u64 {
+    fs::read_to_string(format!("{PARAMS}/{name}"))
+        .unwrap()
+        .trim()
+        .parse()
+        .unwrap()
+}
+
+pub(super) fn test_failed_flag_update() {
+    const GET: libc::c_ulong = 0x80086601;
+    const SET: libc::c_ulong = 0x40086602;
+    const IMMUTABLE: i32 = 0x10;
+    let name = path("audit-flags");
+    fs::write(&name, b"old").unwrap();
+    let file = fs::File::open(&name).unwrap();
+    file.sync_all().unwrap();
+    let flags = |file: &fs::File| {
+        let mut value: i32 = 0;
+        assert_eq!(unsafe { libc::ioctl(file.as_raw_fd(), GET as _, &mut value) }, 0);
+        value
+    };
+    let original = flags(&file);
+    let new = original | IMMUTABLE;
+    let _fail = Param::set(
+        "audit_fail_flags_ino",
+        &file.metadata().unwrap().ino().to_string(),
+    );
+    assert_eq!(unsafe { libc::ioctl(file.as_raw_fd(), SET as _, &new) }, -1);
+    assert_eq!(
+        std::io::Error::last_os_error().raw_os_error(),
+        Some(libc::EIO)
+    );
+    assert_injected("audit_fail_flags_ino");
+    assert_eq!(flags(&file), original, "live flags after rejected update");
+    drop(file);
+    fs::write(&name, b"live").unwrap();
+    evict(&name);
+    assert_eq!(
+        flags(&fs::File::open(&name).unwrap()),
+        original,
+        "flags after eviction"
+    );
+    fs::write(&name, b"reopened").unwrap();
+    fs::remove_file(name).unwrap();
+}
+
+pub(super) fn test_sparse_lookup_count() {
+    let name = path("audit-sparse");
+    let file = fs::File::create_new(&name).unwrap();
+    let _pid = Param::set("audit_seek_tid", &unsafe { libc::gettid() }.to_string());
+    let mut worst = 0;
+    for size in [4 << 20, 128 << 20] {
+        file.set_len(size).unwrap();
+        for whence in [libc::SEEK_HOLE, libc::SEEK_DATA] {
+            let before = param("audit_seek_calls");
+            let found = unsafe { libc::lseek(file.as_raw_fd(), 0, whence) };
+            if whence == libc::SEEK_HOLE {
+                assert_eq!(found, 0);
+            } else {
+                assert_eq!(found, -1);
+                assert_eq!(
+                    std::io::Error::last_os_error().raw_os_error(),
+                    Some(libc::ENXIO)
+                );
+            }
+            let calls = param("audit_seek_calls") - before;
+            eprintln!("seek {whence}, {size} sparse bytes: {calls} extent queries");
+            worst = worst.max(calls);
+        }
+    }
+    assert!(worst <= 2, "{worst} extent queries on an empty file");
+    drop(file);
+    fs::remove_file(name).unwrap();
+}
+
+pub(super) fn test_single_dirty_range_visits() {
+    let name = path("audit-range-visits");
+    for chunks in [1u64, 32] {
+        // Populate separately so each read maps a resident 2 MiB range. A single
+        // page in each range holds data; the guest needs no large allocation.
+        let create = fs::File::create(&name).unwrap();
+        for chunk in 0..chunks {
+            create.write_all_at(b"x", chunk << 21).unwrap();
+        }
+        create.sync_all().unwrap();
+        drop(create);
+        read_in_sealed(&name);
+        let file = fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .open(&name)
+            .unwrap();
+        for chunk in 0..chunks {
+            let mut byte = [0];
+            file.read_exact_at(&mut byte, chunk << 21).unwrap();
+            assert_eq!(byte, [b'x']);
+        }
+        let written = param("audit_written_pages");
+        file.write_all_at(b"y", 0).unwrap();
+        let _pid = Param::set("audit_visit_tid", &unsafe { libc::gettid() }.to_string());
+        let before = param("audit_range_visits");
+        file.sync_all().unwrap();
+        let visits = param("audit_range_visits") - before;
+        assert_eq!(
+            param("audit_written_pages") - written,
+            1,
+            "one page written back"
+        );
+        assert_eq!(
+            param("audit_resident_ranges"),
+            chunks,
+            "resident range count"
+        );
+        eprintln!("{chunks} resident ranges, one dirty page: {visits} range dirty checks");
+        assert!(visits <= 8, "{visits} checks to write back one dirty range");
+        drop(file);
+        fs::remove_file(&name).unwrap();
+    }
+}
+
+fn dax_file(name: &str) -> fs::File {
+    let name = path(name);
+    fs::write(&name, b"before").unwrap();
+    read_in_sealed(&name);
+    fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(name)
+        .unwrap()
+}
+
+const WRITEBACK: u64 = 1 << 8;
+const BUSY_COUNTED: u64 = 1 << 11;
+
+fn release_busy_count() {
+    fs::write(format!("{PARAMS}/dax_pause"), WRITEBACK.to_string()).unwrap();
+}
+
+// TASK-536. The budget worker uses the same collector as settle. Check
+// membership independently so a VFS writeback before settle cannot mask it.
+pub(super) fn test_busy_file_collection() {
+    unmount();
+    mount();
+    let low = dax_file("audit-low");
+    let high = dax_file("audit-high");
+    let ino = high.metadata().unwrap().ino();
+    assert!(low.metadata().unwrap().ino() < ino);
+    let _old = Param::set("audit_old_ino", &ino.to_string());
+    high.write_all_at(b"after!", 0).unwrap();
+    let observed = param("audit_collections");
+    let _pause = Pauses::begin(BUSY_COUNTED);
+    fs::write(format!("{PARAMS}/dax_rebind_now"), "1").unwrap();
+    Pauses::wait(BUSY_COUNTED);
+    low.write_all_at(b"lower!", 0).unwrap();
+    fs::write(format!("{PARAMS}/dax_pause"), "0").unwrap();
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while param("audit_collections") == observed {
+        assert!(
+            Instant::now() < deadline,
+            "busy-file collection did not finish"
+        );
+        std::thread::yield_now();
+    }
+    assert_eq!(
+        param("audit_old_counted"),
+        1,
+        "older inode must be busy in the first pass"
+    );
+    assert_eq!(
+        param("audit_old_selected"),
+        1,
+        "continuously busy inode omitted"
+    );
+}
+
+// The real syscall, with the older writeback stopped before its bytes reach
+// Fxfs. Observe a blocked writeback or actual syscall completion. Elapsed
+// time alone cannot establish that syncfs waited for this file.
+pub(super) fn test_syncfs_older_writeback() {
+    unmount();
+    mount();
+    let low = dax_file("sync-low");
+    let high = dax_file("sync-high");
+    let ino = high.metadata().unwrap().ino();
+    assert!(low.metadata().unwrap().ino() < ino);
+    let _old = Param::set("audit_old_ino", &ino.to_string());
+    high.write_all_at(b"after!", 0).unwrap();
+    std::thread::scope(|scope| {
+        let _waiter = Param::set("audit_wait_tid", "0");
+        let _scan = Param::set("audit_scan_tid", &u32::MAX.to_string());
+        let _pause = Pauses::begin(WRITEBACK | BUSY_COUNTED);
+        let writer = scope.spawn(|| high.sync_all().unwrap());
+        Pauses::wait(WRITEBACK);
+        let (started, tid) = std::sync::mpsc::channel();
+        let syncer = scope.spawn({
+            let low = &low;
+            move || {
+                let tid = unsafe { libc::gettid() };
+                fs::write(format!("{PARAMS}/audit_scan_tid"), tid.to_string()).unwrap();
+                started.send(tid).unwrap();
+                unsafe { libc::syncfs(low.as_raw_fd()) }
+            }
+        });
+        let stack_path = format!("/proc/self/task/{}/stack", tid.recv().unwrap());
+        let deadline = Instant::now() + Duration::from_secs(10);
+        let mut reached_collection = false;
+        loop {
+            if !reached_collection && param("dax_paused") & BUSY_COUNTED != 0 {
+                low.write_all_at(b"lower!", 0).unwrap();
+                reached_collection = true;
+                release_busy_count();
+            }
+            let waiter = param("audit_wait_tid");
+            if waiter != 0 {
+                let stack = fs::read_to_string(&stack_path).unwrap_or_default();
+                let waiting =
+                    fs::read_to_string(format!("/proc/{waiter}/stack")).unwrap_or_default();
+                let vfs_wait = (stack.contains("writeback_inodes_sb")
+                    || stack.contains("sync_inodes_sb"))
+                    && (waiting.contains("cladefs_dax_writepages")
+                        || waiting.contains("cladefs_vfs_write_inode"));
+                let settle_wait = stack.contains("cladefs_dax_settle")
+                    && stack.contains("cladefs_dax_write_back");
+                if vfs_wait || settle_wait {
+                    eprintln!("thread waiting for the older inode:\n{waiting}");
+                    eprintln!("syncfs stack while the older writeback is paused:\n{stack}");
+                    break;
+                }
+            }
+            assert!(
+                !syncer.is_finished(),
+                "syncfs returned while the older writeback was paused"
+            );
+            assert!(
+                Instant::now() < deadline,
+                "no observation of what syncfs waited for"
+            );
+            std::thread::yield_now();
+        }
+        eprintln!(
+            "older writeback waited on; reached final collection first: {reached_collection}"
+        );
+        drop(_pause);
+        writer.join().unwrap();
+        assert_eq!(syncer.join().unwrap(), 0, "syncfs");
+    });
+    drop(high);
+    drop(low);
+    unmount();
+    mount();
+    assert_eq!(fs::read(path("sync-high")).unwrap(), b"after!");
+}

# Kernel: sim
# Killer: scenarios cow_rebind_skips_dirty
#
# TASK-164.4, doc-13: writeback write-protects nothing, as when it left it to
# dax_writeback_mapping_range, not forced to WB_SYNC_ALL, which alone acts: a fault's PTE stays
# writable, and a write through it after the copy is in no set. cow_rebind_skips_dirty: the write
# after the rebind never reaches Fxfs; and cow_writeback_against_mapped_writes, an fsync missing a write
# before it. Since TASK-164.9 writeback cleans no DAX entries: this takes its write-protect away.

--- a/guest/linux/fs/cladefs/dax.c
+++ b/guest/linux/fs/cladefs/dax.c
@@ -2226,7 +2226,6 @@
 	}
 	cladefs_dax_count(dax, file, 0, -pages);
 	up_write(&file->sem);
-	cladefs_dax_protect(inode->i_mapping, batch, nr);
 	/* Before it reads its ranges' window pages, which nothing may free (pause points). */
 	cladefs_dax_pause_file(CLADEFS_DAX_STEP_WRITEBACK, inode->i_ino);
 	err = cladefs_dax_write_pages(dax, inode, batch, nr, parts, run_parts, &kept);

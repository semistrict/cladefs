#
# TASK-149.16: Fxfs's DAX mappings VM_MIXEDMAP again, which a fork copies the PTEs of, a large
# folio's as one, all writable if any is: a chunk read in whole, its PMD split by a write, then
# read page by page, gave a child writable PTEs of pages no PRIVATE had made the VM's, and its
# write to one the host refused till the VM went down (GCE r861, fxfs-guest-fsx-faults-dax).
# Equivalent since board 14407: the first write to a PMD-mapped range invalidates the PMD entry in
# place and splits its 2 MiB compound folio back to order-0 folios, so no large folio ever mixes
# writable and read-only PTEs even if VM_MIXEDMAP were set. Kept out of cladefs_dax_mmap as
# defense-in-depth.

--- a/guest/linux/fs/cladefs/dax.c
+++ b/guest/linux/fs/cladefs/dax.c
@@ -3529,7 +3529,7 @@
 	 * of a chunk read in whole, a store having split its PMD. The child's store to one the host
 	 * refused, again and again (GCE r861, TASK-149.16). A child's PTEs are its own faults'.
 	 */
-	vm_flags_set(vma, VM_HUGEPAGE);
+	vm_flags_set(vma, VM_MIXEDMAP | VM_HUGEPAGE);
 	return 0;
 }
 

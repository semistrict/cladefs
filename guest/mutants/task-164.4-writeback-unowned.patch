# Kernel: sim
# Killer: scenarios cow_rebind_against_mapped_writes
#
# TASK-164.4, doc-13: writeback takes pages the host hasn't made private, an iomap having dirtied
# them before their writes: their window pages map the old blocks, which die as the writeback moves
# them, and read zeros once Fxfs frees them, which the write copies. cow_writeback_before_write;
# interleave's seed 2802 at 1,000 operations. Since TASK-164.9 the iomap that dirties a page makes
# it private (cladefs_dax_dirty), and writeback has nothing of it to forget: this has the iomap
# leave it to the write, as the host would copy at it, which guest/sim's host refuses, the oracle of
# dirty implies private, at the first write of any cow_ scenario.

--- a/guest/linux/fs/cladefs/dax.c
+++ b/guest/linux/fs/cladefs/dax.c
@@ -2708,18 +2708,8 @@
 		err = -ENOBUFS;
 		goto unreserve;
 	}
-	if (newly) {
-		/* The pages private already, those others' iomaps made so meanwhile too, stay so. */
-		err = cladefs_device_private(dax->dev, cladefs_dax_page_offset(range, first),
-					  (u64)(pages + ahead) << PAGE_SHIFT);
-		atomic64_inc(&dax->privates);
-		if (err) {
-			err = cladefs_dax_private_failed(dax, cladefs_dax_page_offset(range, first),
-						      pages + ahead, newly + beyond, err);
-			goto unreserve;
-		}
+	if (newly)
 		WRITE_ONCE(range->file->dirtied, jiffies);
-	}
 	made = cladefs_dax_pages_dirty(range->state, first, pages);
 	if (ahead) {
 		ahead_made = cladefs_dax_pages_private_ahead(range->state, first + pages, ahead);

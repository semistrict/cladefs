# Kernel: release
# Killer: fxfs-guest-checks-dax
#
# TASK-149.42 / board 14407: cladefs_dax_iomap_write skips splitting a PMD-mapped range back to
# order-0 folios on its first write: a chunk mapped 2 MiB at once stays an order-9 compound folio
# after a write splits its PMD, so mprotect/mremap batch its PTEs regardless of dirtiness and make
# clean shared sibling PTEs writable without a write fault, taking the VM down with AccessRefused
# (cow_mprotect_after_a_split_pmd, cow_mremap_after_a_split_pmd). The run goes down, naming no
# check: the suite is the killer.

--- a/guest/linux/fs/cladefs/dax.c
+++ b/guest/linux/fs/cladefs/dax.c
@@ -2534,8 +2534,7 @@
 	if (IS_ERR(range))
 		return PTR_ERR(range);
 	start = cladefs_dax_chunk_start(range);
-	if (range->region || !smp_load_acquire(&range->no_pmd) ||
-	    start + ((loff_t)range->pages << PAGE_SHIFT) <= pos) {
+	if (range->region || start + ((loff_t)range->pages << PAGE_SHIFT) <= pos) {
 		cladefs_dax_put_range(dax, range);
 		return -EXDEV;
 	}

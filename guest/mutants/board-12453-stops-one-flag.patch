# Kernel: sim
# Killer: scenarios volume_leaves_during_eviction
#
# board 12453: cladefs_dax_stop and cladefs_dax_start set and cleared one flag, so a start undid
# every stop, not its own: a volume's leave (cladefs_vfs_filesystem_leave), or a thaw, started the
# budget's worker while another volume's cladefs_vfs_kill_sb, its stop taken, had its inodes still
# to evict, and the worker's relieve could igrab one (Busy inodes after unmount) or write back
# during the eviction. Found while fixing board 10373; no test had two stops at once.
# volume_leaves_during_eviction holds one volume's unmount after its stop as another volume
# unmounts, a freeze and thaw come and go and a seal's end kicks: the worker writes back the four
# dirty private pages with the eviction to come.

--- a/guest/linux/fs/cladefs/dax.c
+++ b/guest/linux/fs/cladefs/dax.c
@@ -3333,7 +3333,7 @@
 {
 	/* cladefs: under the kicks' lock, so that none queues a round once it is set (board 10373). */
 	mutex_lock(&dax->kick_lock);
-	WRITE_ONCE(dax->stops, dax->stops + 1);
+	WRITE_ONCE(dax->stops, 1);
 	mutex_unlock(&dax->kick_lock);
 	cancel_work_sync(&dax->work);
 }
@@ -3348,7 +3348,7 @@

 	mutex_lock(&dax->kick_lock);
 	if (!WARN_ON_ONCE(!dax->stops))
-		WRITE_ONCE(dax->stops, dax->stops - 1);
+		WRITE_ONCE(dax->stops, 0);
 	started = !dax->stops;
 	mutex_unlock(&dax->kick_lock);
 	if (started)

[ sashal: Adjusted context for direct i_state accesses in inode_unpin_lru_isolating() where upstream uses inode state accessors. ]
Signed-off-by: Sasha Levin <sashal@kernel.org>

[ cladefs: rebased onto 6.18.62's inode_lru_isolate(), which still drops an
  inode's metadata buffers there: 6.18.64 carries 972b9dd4e418 ("fs: Ignore
  inode metadata buffers in inode_lru_isolate()") as this change's
  prerequisite, which without 77ff1ff2f3c5 ("ext4: Sync and invalidate
  metadata buffers from ext4_evict_inode()") lets an ext4 filesystem with no
  journal lose a dirty metadata buffer as its inode is evicted (hotbed review
  155). A leftover is a buffer or a page; i_state is set directly, as 6.18
  does, without d8753f788ab4's accessors. ]

diff --git a/fs/inode.c b/fs/inode.c
--- a/fs/inode.c
+++ b/fs/inode.c
@@ -583,12 +583,11 @@ static void inode_pin_lru_isolating(struct inode *inode)
 
 static void inode_unpin_lru_isolating(struct inode *inode)
 {
-	spin_lock(&inode->i_lock);
+	lockdep_assert_held(&inode->i_lock);
 	WARN_ON(!(inode->i_state & I_LRU_ISOLATING));
 	inode->i_state &= ~I_LRU_ISOLATING;
 	/* Called with inode->i_lock which ensures memory ordering. */
 	inode_wake_up_bit(inode, __I_LRU_ISOLATING);
-	spin_unlock(&inode->i_lock);
 }
 
 static void inode_wait_for_lru_isolating(struct inode *inode)
@@ -967,7 +966,13 @@ static enum lru_status inode_lru_isolate(struct list_head *item,
 				__count_vm_events(PGINODESTEAL, reap);
 			mm_account_reclaimed_pages(reap);
 		}
+
+		spin_lock(&inode->i_lock);
+		/* The walk restarts here: don't retry leftovers right away */
+		if (inode_has_buffers(inode) || !mapping_empty(&inode->i_data))
+			inode->i_state |= I_REFERENCED;
 		inode_unpin_lru_isolating(inode);
+		spin_unlock(&inode->i_lock);
 		return LRU_RETRY;
 	}
 

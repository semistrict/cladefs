# cladefs's options, over Firecracker's configuration (scripts/build-guest-kernel.sh concatenates
# them, the later overriding the earlier): BSD-3-Clause, as cladefs is.
#
# Fxfs, and the extent-store device's driver it stores its filesystem through.
CONFIG_VIRTIO_EXTENT=y
CONFIG_CLADEFS_FS=y
# Every device on virtio-PCI (Firecracker's --enable-pci, TASK-273): no virtio-MMIO driver, so a
# device left on MMIO is not found, rather than run there.
# CONFIG_VIRTIO_MMIO is not set
# virtio-pmem, for the benchmark's ext4 with DAX on writable pmem, which the guest's Fxfs compares
# with.
CONFIG_VIRTIO_PMEM=y
# sysrq, through /proc/sysrq-trigger only, whose blocked tasks' stacks (w) the bench's watchdog
# dumps when a workload hangs.
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x0
# A console on Firecracker's serial port, an 8250 UART (on arm64, one the device tree describes).
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
# xfstests generic/798.
CONFIG_CACHESTAT_SYSCALL=y
# Tracepoints, fs/cladefs's among them (cladefs_trace.h, TASK-44.16), in tracefs, for perf and bpftrace
# (docs/guest-tracepoints.md). Dynamic ftrace (CONFIG_FUNCTION_TRACER + CONFIG_DYNAMIC_FTRACE)
# populates /sys/kernel/tracing/available_filter_functions so bpftrace kprobe:/fentry: probes attach
# cleanly and kprobes use ftrace instead of int3 traps.
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
# BPF programs on tracepoints (bpftrace), through uprobe events, which bring event tracing.
CONFIG_BPF_EVENTS=y
# eBPF JIT, kprobes, syscall tracepoints, BTF, and scheduler stats for bpftrace, perf, and
# always-on continuous eBPF profiling inside Firecracker guests.
CONFIG_BPF_JIT=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_SCHEDSTATS=y
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
# An oops panics the kernel, and a panic resets the VM at once, so that it ends (TASK-311). A task
# that oopses dies holding what it held: a spinlock taken with interrupts off, which another CPU
# then spins on, deaf to the TLB flushes' IPIs every other CPU waits on, soft lockups on all of
# them for minutes, till the oops had scrolled out of the host's tail of the console. Panicked, the
# guest stops writing, a crash that doc-12's contract covers (what was synced is kept), and the
# oops is the console's last report. Firecracker's own guests run on after an oops, and halt on a
# panic with a vCPU looping in it (PANIC_TIMEOUT=0); a command line's oops= and panic= still say
# otherwise.
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=-1
# Nested KVM, so guests on hosts with nested virtualization (such as Firecracker dev workspaces)
# expose /dev/kvm and can boot nested microVMs. On arm64 olddefconfig drops the x86-only AMD/Intel
# symbols.
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_AMD=y
CONFIG_KVM_INTEL=y
# Compressed in-RAM swap (/dev/zram0) so guests absorb anonymous memory spikes and support
# in-guest cgroup memory.reclaim without disk swap.
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
# What no sandbox guest of cladefs's uses, its root a cell's Fxfs: each kernel's code and data is
# every VM's RAM, resident on the host once loaded (board 5649, a VM's memory in cells-per-host's
# breakdown, guest_reserved_mib). NFS and its RPC, as a root too; SquashFS; IPv6 segment routing and
# multicast routing; DAMON's monitoring and reclaim; USB, which Firecracker has no controller for;
# the BPF iterators' preloaded user-mode helper; and a DAX device's memory hot-added as RAM.
# CONFIG_NFS_FS is not set
# CONFIG_ROOT_NFS is not set
# CONFIG_SUNRPC is not set
# CONFIG_SQUASHFS is not set
# CONFIG_IPV6_SEG6_LWTUNNEL is not set
# CONFIG_IPV6_SEG6_HMAC is not set
# CONFIG_IP_MROUTE is not set
# CONFIG_IPV6_MROUTE is not set
# CONFIG_DAMON is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_BPF_PRELOAD is not set
# CONFIG_DEV_DAX_KMEM is not set
